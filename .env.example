# Copy this file to .env and fill in your own key from
# https://www.maanmittauslaitos.fi/kartat-ja-aineistot-rajapinnassa/palvelut-ja-rajapinnat
MML_API_KEY=your-api-key-here

# Optional: only for MML contract licence customers. The free open-data
# service is WMTS-only, which FastMap uses automatically when this is empty.
#MML_WMS_URL=https://sopimus-karttakuva.maanmittauslaitos.fi/avoin/wms/1.0.1/

# Optional rendering limits (defaults shown). Each A4 render holds tens of MB
# of raster: keep RENDER_WORKERS low on small instances. Requests beyond
# MAX_PENDING_JOBS (queued + rendering) get "503 busy, retry".
#RENDER_WORKERS=2
#MAX_PENDING_JOBS=10
#JOB_TTL_S=1800   # seconds a finished but undownloaded result is kept
